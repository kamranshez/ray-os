.env

# Thumbnail generator temp batch dirs (cleaned up after generation)
# Final outputs in output/<video-id>/ are tracked via Git LFS

# Video transcriber outputs (generated transcript files)
.claude/skills/video-transcriber/outputs/

# Temporary git worktrees from subagents
.claude/worktrees/

# macOS finder metadata
.DS_Store

# Swift Package Manager build artifacts (e.g. SpeakerNotes macOS app)
.build/
.swiftpm/
*.xcuserstate
DerivedData/
# Playwright MCP browser-automation artifacts (ephemeral traces/logs)
.playwright-mcp/
